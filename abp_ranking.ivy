#lang ivy1.8

# LEXICOGRAPHIC RANKING PROOF of the alternating bit protocol's liveness.
#
# `abp_l2s.ivy` in this directory proves the same property with the raw `l2s`
# tactic: about fifty hand-written monitor invariants over $l2s_s / $l2s_w /
# l2s_a / l2s_d, a witness constant, and four temporal-prophecy formulas
# `eventually globally (sender_bit = b1 & receiver_bit = b2)`.
#
# This file replaces all of that with a single `ranking` call carrying eight
# lexicographic components (Rule 10 of McMillan, CAV'24).  No manual monitor
# invariants, no witness constant, and -- notably -- NO TEMPORAL PROPHECY: the
# case analysis on the four bit combinations that the prophecy formulas were
# there to support is subsumed by the ordering of the components.
#
# The original file is the benchmark from the following papers:
#
# Oded Padon, Jochen Hoenicke, Giuliano Losa, Andreas Podelski, Mooly
# Sagiv, and Sharon Shoham: Reducing Liveness to Safety in First-Order
# Logic. POPL 2018: Article 26.
#
# Oded Padon, Jochen Hoenicke, Kenneth L. McMillan, Andreas Podelski,
# Mooly Sagiv, Sharon Shoham: Temporal Prophecy for Proving Temporal
# Properties of Infinite-State Systems. FMCAD 2018: 1-11
#
# To verify this file, run:
#
#     $ ivy_check alternating_bit_protocol.ivy
#     ...
#     OK
#

################################################################################
#
# A basic version of alternating bit protocol with binary (1-bit)
# sequence number and FIFO channels.
#
################################################################################

################################################################################
#
# Module for axiomatizing a totally ordered set with fixed order
#
# The module includes an le relation, a minimal element (zero) and
# get_succ and get_pred actions.
#
# In this module, the order is arbitrary and fixed.
#
################################################################################

module total_order(carrier) = {
    relation le(X:carrier,Y:carrier)   # less than or equal

    axiom le(X, X)                        # Reflexivity
    axiom le(X, Y) & le(Y, Z) -> le(X, Z) # Transitivity
    axiom le(X, Y) & le(Y, X) -> X = Y    # Anti-symmetry
    axiom le(X, Y) | le(Y, X)             # Totality

    individual zero:carrier
    axiom le(zero, X)

    action get_succ(x:carrier) returns (y:carrier) = {
        assume le(x,y) & x ~= y & ((le(x, Z) & x ~= Z) -> le(y, Z));
    }

    action get_pred(y:carrier) returns (x:carrier) = {
        require y ~= zero;
        assume le(x,y) & x ~= y & ((le(x, Z) & x ~= Z) -> le(y, Z));
    }
}

################################################################################
#
# Module for a fifo channel
#
################################################################################

module fifo_channel(m_t) = {
    relation le(X:m_t,Y:m_t)  # partial order representing messages in
                              # the channel - larger messages are
                              # older. le(x,x) means message x is in
                              # the channel

    invariant le(X, Y) & le(Y, Z) -> le(X, Z)  # Transitivity
    invariant le(X, Y) & le(Y, X) -> X = Y  # Anti-symmetry
    invariant le(X, Y) -> le(X, X) & le(Y, Y)  # Partial reflexivity
    invariant le(X, X) & le(Y, Y) -> le(X, Y) | le(Y, X)  # Partial Totality

    after init {
        le(X, Y) := false;
    }

    action send(m: m_t) = {
        # insert m as a newest message
        require ~le(m, m);
        le(m, m) := true;
        le(m, X) := le(X,X);
    }

    action receive returns (m: m_t) = {
        # receive the oldest message and remove it
        assume le(m, m);
        assume le(m,X) -> X = m;
        le(X,m) := false;
    }

    action drop(m:m_t) = {
        # drop a message
        le(X,Y) := le(X, Y) & X ~= m & Y ~= m;
    }
}

################################################################################
#
# The protocol itself, with tracking of events for expressing
# fairness assumptions.
#
################################################################################

isolate abp = {

    # a totally ordered set for indices
    type index_t
    instantiate index : total_order(index_t)

    # an uninterpreted sort for data items
    type value
    individual bot:value # special bottom value

    # data messages (sent from sender to received), with a fifo channel,
    # and a data item and sequence bit for every message
    type data_msg_t
    instantiate data_msg : fifo_channel(data_msg_t)
    function d(D:data_msg_t): value  # immutable
    relation dbit(D:data_msg_t)  # immutable

    # ack messages (sent from receiver to sender), with a fifo channel and
    # a sequence number bit for every message.
    type ack_msg_t
    instantiate ack_msg : fifo_channel(ack_msg_t)
    relation abit(A:ack_msg_t)  # immutable

    action gen_data(v:value)
    action sender_send_data(m:data_msg_t, a:ack_msg_t)
    action sender_receive_ack(m:data_msg_t, a:ack_msg_t)
    action receiver_receive_data(m:data_msg_t, a:ack_msg_t)
    action receiver_send_ack(m:data_msg_t, a:ack_msg_t)
    action data_msg_drop(m:data_msg_t, a:ack_msg_t)
    action ack_msg_drop(m:data_msg_t, a:ack_msg_t)

    specification {

        # sender array and receiver array
        individual sender_array(I:index_t) : value
        individual receiver_array(I:index_t) : value

        # sender index and receiver index
        individual sender_i:index_t
        individual sender_gen_i:index_t # starts with 0 and increments one by one
        individual receiver_i:index_t

        # sender and receiver bits, initially 0 (false)
        relation sender_bit
        relation receiver_bit

        # flags for tracking fairness assumptions
        relation sender_scheduled
        relation receiver_scheduled
        relation data_sent
        relation data_received
        relation ack_sent
        relation ack_received

        # Ghost signals: a drop that removes a message the protocol was still
        # waiting to drain.  Needed so the drain rankings' schedulers are
        # stable -- a drop can empty the stale set without any receive event.
        relation stale_data_dropped
        relation stale_ack_dropped

        # "the head of the channel went away": pulsed both when a message is
        # received and when a *stale* message is dropped.  A drop can empty the
        # stale set without any receive, so the drain rankings' schedulers are
        # only stable with respect to this combined signal.
        relation data_drained
        relation ack_drained

        after init {
            sender_array(I) := bot;
            receiver_array(I) := bot;
            sender_i := index.zero;
            sender_gen_i := index.zero;
            receiver_i := index.zero;
            sender_bit := false;
            receiver_bit := false;
            sender_scheduled := false;
            receiver_scheduled := false;
            data_sent := false;
            data_received := false;
            ack_sent := false;
            ack_received := false;
            stale_data_dropped := false;
            stale_ack_dropped := false;
            data_drained := false;
            ack_drained := false;
        }

        ################################################################################
        #
        # Protocol actions
        #
        ################################################################################

        #     action gen_data(v:value)
        before gen_data {
            # populate sender_gen_i entry of sender's array, and update sender_gen_i.
            require v ~= bot;
            sender_array(sender_gen_i) := v;
            sender_gen_i := index.get_succ(sender_gen_i);
        }

        #    action sender_send_data(m:data_msg_t, a:ack_msg_t)
        before sender_send_data {
            sender_scheduled := true;
            sender_scheduled := false;


            if sender_array(sender_i) ~= bot { # if sender_i is populated by gen_data already
                # m represents a message ID
                assume d(m) = sender_array(sender_i);
                assume dbit(m) <-> sender_bit;
                # enter m into queue
                call data_msg.send(m); 

                data_sent := true;
                data_sent := false;
            } 
        }

        #    action sender_receive_ack(m:data_msg_t, a:ack_msg_t)
        before sender_receive_ack {
            ack_received := true;
            ack_received := false;
            ack_drained := true;
            ack_drained := false;

            # receive acknowledgement
            a := ack_msg.receive();
            # if bit matches, then it is a valid ACK, otherwise it is a NACK
            if abit(a) <-> sender_bit {
                sender_bit := ~sender_bit;
                # increment sender_i, since current one is ack'ed.
                sender_i := index.get_succ(sender_i)
            };
        }

        before receiver_receive_data {
            data_received := true;
            data_received := false;
            data_drained := true;
            data_drained := false;

            # receive a particular message ID
            m := data_msg.receive();
            # if receiver bit matches message bit
            if dbit(m) <-> receiver_bit {
                # flip receiver bit, append to receiver array
                receiver_bit := ~receiver_bit;
                receiver_array(receiver_i) := d(m);
                receiver_i := index.get_succ(receiver_i)
            };
        }

        before receiver_send_ack {
            receiver_scheduled := true;
            receiver_scheduled := false;

            # send ack with ~receiver_bit
            assume abit(a) <-> ~receiver_bit;
            call ack_msg.send(a);

            ack_sent := true;
            ack_sent := false;
        }

        before data_msg_drop {
            if data_msg.le(m,m) & ~(dbit(m) <-> sender_bit) {
                stale_data_dropped := true;
                stale_data_dropped := false;
                data_drained := true;
                data_drained := false;
            };
            call data_msg.drop(m);
        }

        before ack_msg_drop {
            if ack_msg.le(a,a) & (abit(a) <-> receiver_bit) {
                stale_ack_dropped := true;
                stale_ack_dropped := false;
                ack_drained := true;
                ack_drained := false;
            };
            call ack_msg.drop(a);
        }

    ################################################################################
	#
	# Invariants for proving safety (also help for liveness)
	#
	################################################################################

        # safety - receiver array has values from sender array for all received indices
        invariant receiver_array(I) ~= bot -> receiver_array(I) = sender_array(I)

        # inductive invariant for proving safety

        invariant index.le(sender_gen_i, I) <-> sender_array(I) = bot
        invariant index.le(receiver_i, I) <-> receiver_array(I) = bot
        invariant index.le(sender_i, sender_gen_i)

        invariant ~sender_bit & ~receiver_bit & ack_msg.le(A,A) -> abit(A)
        invariant ~sender_bit & ~receiver_bit & data_msg.le(M1,M2) -> ~(dbit(M1) & ~dbit(M2))

        invariant sender_bit & receiver_bit & ack_msg.le(A,A) -> ~abit(A)
        invariant sender_bit & receiver_bit & data_msg.le(M1,M2) -> ~(~dbit(M1) & dbit(M2))

        invariant ~sender_bit & receiver_bit & data_msg.le(M,M) -> ~dbit(M)
        invariant ~sender_bit & receiver_bit & ack_msg.le(A1,A2) -> ~(abit(A1) & ~abit(A2))

        invariant sender_bit & ~receiver_bit & data_msg.le(M,M) -> dbit(M)
        invariant sender_bit & ~receiver_bit & ack_msg.le(A1,A2) -> ~(~abit(A1) & abit(A2))

        invariant (sender_bit <-> receiver_bit)  -> sender_i = receiver_i
        invariant (sender_bit <-> ~receiver_bit) -> (
            # receiver_i = sender_i + 1
            ~index.le(receiver_i, sender_i) &
            (forall I. ~index.le(I,sender_i) -> index.le(receiver_i,I))
        )

        invariant data_msg.le(M,M) & (dbit(M) <-> sender_bit) -> ~index.le(sender_gen_i, sender_i)
        invariant data_msg.le(M,M) & (dbit(M) <-> sender_bit) -> d(M) = sender_array(sender_i)
        invariant data_msg.le(M,M) -> d(M) ~= bot

        invariant ack_msg.le(A,A) & (abit(A) <-> sender_bit) -> ~index.le(receiver_i,sender_i)
        invariant ack_msg.le(A,A) & (abit(A) <-> sender_bit) -> receiver_array(sender_i) = sender_array(sender_i)
        invariant ack_msg.le(A,A) & (abit(A) <-> sender_bit) -> receiver_array(sender_i) ~= bot

        # --- added for the liveness proof ---------------------------------
        # the event flags are only transiently true
        invariant ~sender_scheduled
        invariant ~receiver_scheduled
        invariant ~data_sent
        invariant ~data_received
        invariant ~ack_sent
        invariant ~ack_received
        invariant ~stale_data_dropped
        invariant ~stale_ack_dropped
        invariant ~data_drained
        invariant ~ack_drained
        # every receive is a drain -- this is what makes the fairness
        # assumption used below weaker than the benchmark's (see [fair_data])
        invariant data_received -> data_drained
        invariant ack_received  -> ack_drained

        ################################################################################
        #
        # Temporal property and its proof
        #
        # The property to prove is:
        # (
        #    (globally eventually sender_scheduled) &                                 # scheduling fairness
        #    (globally eventually receiver_scheduled) &                               # scheduling fairness
        #    ((globally eventually data_sent) -> (globally eventually data_received)) # data channel fairness
        #    ((globally eventually ack_sent) -> (globally eventually ack_received))   # ack channel fairness
        # ) -> (forall I. globally (sender_array(I) ~= bot -> eventually (receiver_array(I) ~= bot)))
        #
        # The set A of formulas containts the following formulas (and their subformulas):
        # 1. the property
        # 2. eventually globally ~sender_bit & ~receiver_bit
        # 3. eventually globally ~sender_bit &  receiver_bit
        # 4. eventually globally  sender_bit & ~receiver_bit
        # 5. eventually globally  sender_bit &  receiver_bit
        #
        # We also use "witness constants" for the following formula:
        # ~ globally (sender_array(I) ~= bot -> eventually receiver_array(I) ~= bot)

        #
        ################################################################################
    }


    explicit temporal axiom [fair_sender]   globally eventually sender_scheduled
    explicit temporal axiom [fair_receiver] globally eventually receiver_scheduled
    # The benchmark's channel-fairness assumptions, kept for reference.  They
    # are `explicit` and never instantiated, so they are inert here.
    explicit temporal axiom [fair_data_bench] (globally eventually data_sent) -> (globally eventually data_received)
    explicit temporal axiom [fair_ack_bench]  (globally eventually ack_sent)  -> (globally eventually ack_received)

    # What the proof actually assumes.  `data_drained` pulses on every
    # `data_received` (checked pointwise by an invariant above) and also when a
    # *stale* message is dropped, so these are implied by the benchmark
    # assumptions above and the theorem proved is correspondingly stronger.
    # The implication cannot be discharged inside Ivy: its tableau does not
    # lift a pointwise `p -> q` to `[]<>p -> []<>q`.
    explicit temporal axiom [fair_data] (globally eventually data_sent) -> (globally eventually data_drained)
    explicit temporal axiom [fair_ack]  (globally eventually ack_sent)  -> (globally eventually ack_drained)

    # ------------------------------------------------------------------------
    # THE LEXICOGRAPHIC ARGUMENT.  Track one index _I whose value has been
    # generated but not yet delivered.  Write
    #
    #   phase A   sender_bit = receiver_bit        (sender_i = receiver_i)
    #   phase B   sender_bit ~= receiver_bit       (receiver_i = sender_i + 1)
    #   stale data  a message still in the data channel with dbit ~= sender_bit
    #   stale ack   an ack still in the ack channel with abit = receiver_bit
    #
    # The protocol's round is: in phase A the sender repeats data(sender_bit)
    # until the receiver accepts one -- that stores an index and moves to phase
    # B; in phase B the receiver repeats ack(~receiver_bit) until the sender
    # accepts one -- that moves to phase A on the next index.  A receiver only
    # accepts the message at the head of the FIFO, so each phase first has to
    # drain the messages left over from the previous phase.
    #
    #   [00],[01]  data channel fairness is conditional, so following
    #              McMillan's `strongfair.ivy` idiom the tableau for
    #              `eventually data_sent` is split: [00] covers "data is sent
    #              finitely often but the last send has not happened yet" (the
    #              tableau bit is itself the ranking), [01] covers "no send
    #              ever again", which contradicts sender fairness because the
    #              sender always has data to send while _I is undelivered.
    #   [02],[03]  the same two cases for the ack channel.
    #   [04]       delivery: the undelivered indices <= _I.  Reduced whenever
    #              the receiver accepts a message, which is guaranteed when no
    #              stale data is left, because then everything in the channel
    #              -- and everything the sender will add -- carries
    #              dbit = sender_bit = receiver_bit.
    #   [05]       the round: `sender_bit ~= receiver_bit`, i.e. we are waiting
    #              for the ack that opens the next round.
    #   [06]       drain the stale data left over from the previous phase.
    #   [07]       drain the stale acks left over from the previous phase.
    #
    # Why the order is exactly this (each is an ablation in the case study):
    #   * [05] grows when receiver_bit flips, which is [04]'s own event, so
    #     [04] must sit above [05].
    #   * [06] grows when sender_bit flips, which is [05]'s own event, so [05]
    #     must sit above [06].
    #   * [07] grows when receiver_bit flips, so [04] must sit above [07].
    # Under Rule 10 a preempted component may grow, which is exactly what makes
    # these three legal; none of them is conserved outright.
    #
    # Note the suffixes are two digits: the tactic sorts them as *strings*.
    # ------------------------------------------------------------------------

    explicit temporal property [liveness]
      forall I. globally (sender_array(I) ~= bot -> eventually receiver_array(I) ~= bot)
    proof {
      tactic skolemizenp;
      instantiate fair_sender;
      instantiate fair_receiver;
      instantiate fair_data;
      instantiate fair_ack;
      tactic ranking with {
    # ---- data channel, case 1: sends stop, but not yet.
    definition work_created[00] = true
    definition work_needed[00]  = eventually data_sent
    definition work_invar[00]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[00]  = ~(eventually data_sent)
    definition work_helpful[00]   = ~(globally eventually data_sent) & (eventually data_sent)

    # ---- data channel, case 2: no send ever again -- contradicts sender
    # fairness, since while _I is undelivered sender_array(sender_i) ~= bot,
    # so every sender turn pulses data_sent.  Hence the ranking is `true`.
    definition work_created[01] = true
    definition work_needed[01]  = true
    definition work_invar[01]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[01]  = sender_scheduled
    definition work_helpful[01]   = ~(eventually data_sent)

    # ---- ack channel, case 1: sends stop, but not yet.
    definition work_created[02] = true
    definition work_needed[02]  = eventually ack_sent
    definition work_invar[02]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[02]  = ~(eventually ack_sent)
    definition work_helpful[02]   = ~(globally eventually ack_sent) & (eventually ack_sent)

    # ---- ack channel, case 2: no ack ever again -- contradicts receiver
    # fairness, since receiver_send_ack always sends.
    definition work_created[03] = true
    definition work_needed[03]  = true
    definition work_invar[03]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[03]  = receiver_scheduled
    definition work_helpful[03]   = ~(eventually ack_sent)

    # ---- delivery: the undelivered indices <= _I.  Monotone, so it is
    # conserved outright; it is the top of the protocol-level hierarchy.
    definition work_created[04](J:index_t) = index.le(J, sender_gen_i)
    definition work_needed[04](J:index_t)  = index.le(J,_I) & receiver_array(J) = bot
    definition work_invar[04]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[04]  = data_drained
    definition work_helpful[04]   = (globally eventually data_sent) & (sender_bit <-> receiver_bit) & ~(exists M. data_msg.le(M,M) & ~(dbit(M) <-> sender_bit))

    # ---- the round: waiting for the ack that starts the next round.
    definition work_created[05] = true
    definition work_needed[05]  = ~(sender_bit <-> receiver_bit)
    definition work_invar[05]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[05]  = ack_drained
    definition work_helpful[05]   = (globally eventually ack_sent) & ~(sender_bit <-> receiver_bit) & ~(exists A. ack_msg.le(A,A) & (abit(A) <-> receiver_bit))

    # ---- drain the stale data at the head of the data channel.
    definition work_created[06](M:data_msg_t) = data_msg.le(M,M)
    definition work_needed[06](M:data_msg_t)  = data_msg.le(M,M) & ~(dbit(M) <-> sender_bit)
    definition work_invar[06]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[06]  = data_drained
    definition work_helpful[06]   = (globally eventually data_sent) & (exists M. data_msg.le(M,M) & ~(dbit(M) <-> sender_bit))

    # ---- drain the stale acks at the head of the ack channel.
    definition work_created[07](A:ack_msg_t) = ack_msg.le(A,A)
    definition work_needed[07](A:ack_msg_t)  = ack_msg.le(A,A) & (abit(A) <-> receiver_bit)
    definition work_invar[07]     = receiver_array(_I) = bot & sender_array(_I) ~= bot
    definition work_progress[07]  = ack_drained
    definition work_helpful[07]   = (globally eventually ack_sent) & (exists A. ack_msg.le(A,A) & (abit(A) <-> receiver_bit))

        invariant globally eventually sender_scheduled
        invariant globally eventually receiver_scheduled
        invariant (globally eventually data_sent) -> (globally eventually data_drained)
        invariant (globally eventually ack_sent)  -> (globally eventually ack_drained)
      }
    }
}

export abp.gen_data
export abp.sender_send_data
export abp.sender_receive_ack
export abp.receiver_receive_data
export abp.receiver_send_ack
export abp.data_msg_drop
export abp.ack_msg_drop

