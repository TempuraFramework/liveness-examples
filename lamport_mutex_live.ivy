#lang ivy1.8

# ---------------------------------------------------------------------------
# Lamport's distributed mutual exclusion (DME) algorithm -- liveness.
#
# Flat (monolithic) first-order transition system, derived from the protocol
# encoding of `lamport_mutex_man.ivy`:
#
#   * three message kinds, request / reply / release
#   * every node keeps a request queue `req(N,X)` -- the timestamp of the
#     request it last heard from X, 0 if none
#   * every node keeps `rep(N,X)` -- the highest reply timestamp heard from X
#   * a node enters its critical section when its own request is
#     lexicographically least in its queue and it has heard a *later* reply
#     from every other node
#   * channels are per-ordered-pair FIFO (this is the assumption
#     `lamport_mutex_man.ivy` encodes with its `sent(S,D,M)` overlay and the
#     comment "Because of in-order delivery, the timestamps are received in
#     increasing order")
#
# The model is flattened out of the `process node(self)` / `isolate overlay`
# form because the liveness-to-safety tactics need one monolithic transition
# system.  `node(Y).request_ts(X)` becomes `req(Y,X)`, and `overlay.sent`
# becomes `chan`.
# ---------------------------------------------------------------------------

include order

# ---- host identifiers: a finite, totally ordered type -----------------------

finite type node
relation (X:node < Y:node)
axiom [node_trans] (X:node < Y & Y < Z) -> X < Z
axiom [node_asym]  ~(X:node < Y & Y < X)
axiom [node_total] X:node < Y | X = Y | Y < X
relation (X:node <= Y:node)
definition (X:node <= Y:node) = (X < Y | X = Y)

# ---- logical timestamps -----------------------------------------------------

instance ts : unbounded_sequence

# ---- messages ---------------------------------------------------------------

type msg_kind = {request, reply, release}

# ---- per-node control state -------------------------------------------------

type mode = {idle, waiting, critical}

var st(N:node) : mode            # idle / waiting / critical
var clock(N:node) : ts           # the node's Lamport clock
var req(N:node, X:node) : ts     # N's request queue: X's request, 0 = none
var rep(N:node, X:node) : ts     # highest reply timestamp N heard from X

# ---- the network ------------------------------------------------------------
#
# chan(S,D,K,T) : a message of kind K carrying timestamp T is in flight from
# S to D.  Delivery is in increasing timestamp order per ordered pair, which
# (because a node stamps every message it sends with a fresh, strictly larger
# timestamp) is exactly FIFO.

relation chan(S:node, D:node, K:msg_kind, T:ts)

# rcvd(D,S) : ghost.  The highest timestamp D has taken off the channel from
# S.  Only used to state the FIFO invariant.
var rcvd(N:node, X:node) : ts

# last_ts / last_node : ghost.  The timestamp minted by the last step, and the
# node that minted it.  `last_ts` is a *nullary* symbol, so the liveness
# monitor adds its value to the abstraction domain `l2s_d` at the end of every
# step; that is what makes "every in-flight timestamp has been produced" an
# inductive invariant, i.e. Rule 5 finiteness for the timestamp sort.
# `last_node` exists only so that the invariant `clock(last_node) = last_ts`
# can tie `last_ts` to the real state -- without a reader, Ivy slices the
# ghost away and the abstraction domain never sees the new timestamps.
var last_ts : ts
var last_node : node

# replied(S,D) / lastrel(S,D) : ghost.  The timestamp of the last *reply* and
# the last *release* S sent to D (0 if none).  `lastrr` is the later of the
# two: the timestamp of the last message S sent D that can unblock D --
# a reply satisfies D's "heard a later reply from everyone" test, a release
# clears D's request queue.  Ranking [03] drains exactly the channel prefix up
# to `lastrr`.
var replied(S:node, D:node) : ts
var lastrel(S:node, D:node) : ts

function lastrr(S:node, D:node) = ts.max2(replied(S,D), lastrel(S,D))

# ---- lexicographic order on (timestamp, node) -------------------------------

function lexord(T1:ts, N1:node, T2:ts, N2:node) =
    T1 < T2 | (T1 = T2 & N1 < N2)

function lexle(T1:ts, N1:node, T2:ts, N2:node) =
    T1 < T2 | (T1 = T2 & (N1 = N2 | N1 < N2))

# X is pending with a request at or before (T,C) in the global (timestamp,id)
# order -- "X is ahead of, or is, the node we are tracking".
relation aheadeq(X:node, T:ts, C:node) =
    st(X) ~= idle & lexle(req(X,X), X, T, C)


# ---- fairness flags ---------------------------------------------------------
#
# Every fair rule is a *guarded command* whose flag is pulsed before the
# guard, so that a turn offered to a disabled rule is a stutter step and
# `globally eventually wf_x` is an honest statement about the scheduler
# (LIVENESS_CASE_STUDY_GERMAN.md section 3).

# blocked(N) : N's cached answer to "is some peer still holding me up?".  A
# node recomputes it every time its own view of a peer changes; `check_cs`
# then just reads the flag.  Caching the test is an implementation detail, but
# it is also what keeps the proof inside the decidable fragment: the
# `work_helpful` of ranking [04] has to name the entry guard, and a guard
# written as a quantified formula puts a forall under a negation and takes the
# verification condition out of FAU (LIVENESS_GUIDE.md section 4.5).
relation blocked(N:node)

# front / has_front : the pending node whose request is least in the global
# (timestamp, id) order, exactly as `bakery.ivy` tracks the least ticket.
# It has to be a *nullary* symbol: the scheduler of ranking [04] has to point
# at the node that can actually enter, and a node-indexed witness function
# would put a node -> node arc in the stratification graph and take the
# verification condition out of FAU.
var front : node
relation has_front

relation wf_recv(S:node, D:node)
relation wf_check(N:node)
relation wf_exit(N:node)

after init {
    st(N) := idle;
    clock(N) := 0;
    req(N,X) := 0;
    rep(N,X) := 0;
    rcvd(N,X) := 0;
    replied(S,D) := 0;
    lastrel(S,D) := 0;
    chan(S,D,K,T) := false;
    last_ts := 0;
    blocked(N) := false;
    has_front := false;
    wf_recv(S,D) := false;
    wf_check(N) := false;
    wf_exit(N) := false;
}

# ---------------------------------------------------------------------------
# refresh(n) -- recompute n's `blocked` flag.  n is held up by a peer y if y
# has a request in n's queue that is ordered before n's own, or if n has not
# yet heard a reply from y later than its own request.
# ---------------------------------------------------------------------------

action refresh(n:node) = {
    if some y:node. y ~= n
         & ((req(n,y) ~= 0 & ~lexord(req(n,n),n,req(n,y),y))
            | rep(n,y) <= req(n,n)) {
        blocked(n) := true;
    } else {
        blocked(n) := false;
    }
}

# ---------------------------------------------------------------------------
# request_cs(n) -- the client of node n asks to enter the critical section.
#
# This is an *environment* action: it carries no fairness flag, because we
# never want to assume that requests are issued.
# ---------------------------------------------------------------------------

action request_cs(n:node) = {
    if st(n) = idle {
        var t := clock(n).next;
        clock(n) := t;
        last_ts := t;
        last_node := n;
        req(n,n) := t;
        chan(n,D,request,t) := (D ~= n) | chan(n,D,request,t);
        st(n) := waiting;
        refresh(n);
        if ~has_front | lexord(req(n,n),n,req(front,front),front) {
            front := n;
            has_front := true;
        };
        refresh(front);
    }
}

# ---------------------------------------------------------------------------
# recv(s,d) -- the network delivers the head (least timestamp) of the channel
# from s to d.
# ---------------------------------------------------------------------------

action recv(s:node, d:node) = {
    wf_recv(s,d) := true;
    wf_recv(s,d) := false;
    if some t:ts. (exists K. chan(s,d,K,t)) minimizing t {
        var isreq := chan(s,d,request,t);
        var isrel := chan(s,d,release,t);
        var isrep := chan(s,d,reply,t);
        chan(s,d,K,t) := false;
        rcvd(d,s) := t;
        var nt := ts.max2(t,clock(d)).next;
        clock(d) := nt;
        last_ts := nt;
        last_node := d;
        if isreq {
            req(d,s) := t;
            chan(d,s,reply,nt) := true;
            replied(d,s) := nt;
        } else if isrel {
            req(d,s) := 0;
        } else if isrep {
            rep(d,s) := t;
        };
        refresh(d);
    }
}

# ---------------------------------------------------------------------------
# check_cs(n) -- n tests the entry condition and enters if it holds.
# ---------------------------------------------------------------------------

action check_cs(n:node) = {
    wf_check(n) := true;
    wf_check(n) := false;
    if st(n) = waiting & ~blocked(n) {
        st(n) := critical;
    }
}

# ---------------------------------------------------------------------------
# exit_cs(n) -- n leaves the critical section and broadcasts a release.
# ---------------------------------------------------------------------------

action exit_cs(n:node) = {
    wf_exit(n) := true;
    wf_exit(n) := false;
    if st(n) = critical {
        var t := clock(n).next;
        clock(n) := t;
        last_ts := t;
        last_node := n;
        req(n,n) := 0;
        chan(n,D,release,t) := (D ~= n) | chan(n,D,release,t);
        lastrel(n,D) := (t if D ~= n else lastrel(n,D));
        st(n) := idle;
        refresh(n);
        if some f:node. st(f) ~= idle minimizing req(f,f) {
            if some g:node. st(g) ~= idle & req(g,g) = req(f,f) minimizing g {
                front := g;
                has_front := true;
                refresh(g);
            }
        } else {
            has_front := false;
        };
    }
}

export request_cs
export recv
export check_cs
export exit_cs

# ---------------------------------------------------------------------------
# Safety invariants (ported from lamport_mutex_man.ivy).
# ---------------------------------------------------------------------------

invariant [fair_flags_low1] ~wf_recv(S,D)
invariant [fair_flags_low2] ~wf_check(N)
invariant [fair_flags_low3] ~wf_exit(N)

invariant [no_self_msg] ~chan(S,S,K,T)

invariant [msg_below_clock] chan(S,D,K,T) -> T <= clock(S)
# every message a node sends carries a strictly fresher timestamp, so a
# timestamp identifies a message within a channel
invariant [one_kind] chan(S,D,K1,T) & chan(S,D,K2,T) -> K1 = K2
invariant [req_below_clock] req(D,S) <= clock(S)
invariant [rep_below_clock] rep(D,S) <= clock(S)
invariant [rep_below_own_clock]  rep(S,D)  <= clock(S)
invariant [rcvd_below_own_clock] rcvd(S,D) <= clock(S)
invariant [no_self_state] rep(N,N) = 0 & rcvd(N,N) = 0
invariant [rcvd_below_clock] rcvd(D,S) <= clock(S)
invariant [last_mint] clock(last_node) = last_ts

invariant [pending_iff] st(S) ~= idle <-> req(S,S) ~= 0

invariant [no_regress_req] chan(S,D,K,T) -> req(D,S) <= T
invariant [no_regress_rep] chan(S,D,K,T) -> rep(D,S) <= T
invariant [fifo]           chan(S,D,K,T) -> rcvd(D,S) < T

invariant [rel_before_req] chan(S,D,release,T) & st(S) ~= idle -> T < req(S,S)
invariant [req_le_own]     chan(S,D,request,T) & st(S) ~= idle -> T <= req(S,S)

invariant [request_known]
    st(S) ~= idle & D ~= S ->
        (chan(S,D,request,req(S,S)) | req(D,S) = req(S,S))

invariant [crit_heard]  st(S) = critical & D ~= S -> req(S,S) < rep(S,D)
invariant [crit_least]
    st(S) = critical & D ~= S ->
        (req(S,D) = 0 | lexord(req(S,S),S,req(S,D),D))

# The cached flag really does mean what `check_cs` needs it to mean.
invariant [blocked_sound]
    st(N) = waiting & ~blocked(N) & Y ~= N ->
        ((req(N,Y) = 0 | lexord(req(N,N),N,req(N,Y),Y)) & rep(N,Y) > req(N,N))

# `front` really is the least pending request.
invariant [front_pending] has_front -> st(front) ~= idle
invariant [front_exists]  st(Z) ~= idle -> has_front
invariant [front_min]
    has_front & st(Z) ~= idle & Z ~= front ->
        lexord(req(front,front),front,req(Z,Z),Z)

# The blocked flag of `front` comes with a witness.  `front` is nullary, so
# this existential skolemizes to a constant and stays inside FAU.
invariant [front_blocked_witness]
    has_front & st(front) = waiting & blocked(front) ->
        (exists Y. Y ~= front
                   & ((req(front,Y) ~= 0
                       & ~lexord(req(front,front),front,req(front,Y),Y))
                      | rep(front,Y) <= req(front,front)))

invariant [mutex] st(X) = critical & st(Y) = critical -> X = Y

# ---------------------------------------------------------------------------
# Further invariants, needed only by the liveness argument.
# ---------------------------------------------------------------------------

invariant [replied_below_clock] replied(S,D) <= clock(S)
invariant [no_self_ghost] replied(N,N) = 0 & lastrel(N,N) = 0
invariant [lastrel_below_clock] lastrel(S,D) <= clock(S)

# A reply is never later than the last timestamp taken off the channel, so
# (with [fifo]) nothing already delivered can be undercut by a later arrival.
invariant [rep_le_rcvd] rep(D,S) <= rcvd(D,S)

# "One round at a time": a node has at most one request outstanding, and it
# cannot start a new round until the old one has been delivered and answered
# everywhere -- releasing requires every peer to have replied, and a peer only
# replies to a request it has received.  These five invariants are what rules
# out a node's own stale request lingering in a channel.
invariant [rep_le_replied]   rep(S,D) <= replied(D,S)
invariant [idle_no_request]  st(S) = idle -> ~chan(S,D,request,T)
invariant [req_inflight_unreplied] chan(S,D,request,T) -> replied(D,S) < T
invariant [reply_inflight_unheard]
    chan(D,S,reply,Q) ->
        (st(S) = waiting & rep(S,D) < req(S,S) & rcvd(D,S) >= req(S,S))
invariant [one_reply_inflight]
    chan(D,S,reply,Q1) & chan(D,S,reply,Q2) -> Q1 = Q2
invariant [req_is_own] chan(S,D,request,T) & st(S) ~= idle -> T = req(S,S)

# [aware] : once S's request has been delivered to D, D's clock is strictly
# past it -- so every request D issues from then on is ordered *after* S's.
# This is what makes the "nodes ahead of me" ranking [02] conserved.
invariant [aware]
    st(S) ~= idle & D ~= S & ~chan(S,D,request,req(S,S)) -> clock(D) > req(S,S)

# ... and D has answered it.
invariant [aware_replied]
    st(S) ~= idle & D ~= S & ~chan(S,D,request,req(S,S)) -> replied(D,S) > req(S,S)

# The last reply S sent D is either still in flight or has been recorded.
invariant [replied_inflight]
    replied(S,D) ~= 0 ->
        (chan(S,D,reply,replied(S,D)) | rep(D,S) >= replied(S,D))

# If D's request queue holds a request of S that S is no longer making, then
# S's release is still on its way to D.  This is what lets a blocked node
# always point at a message whose delivery unblocks it.
invariant [stale_release]
    D ~= S & req(D,S) ~= 0 & ~(st(S) ~= idle & req(S,S) = req(D,S)) ->
        (chan(S,D,release,lastrel(S,D)) & lastrel(S,D) > req(D,S))

invariant [stale_request]
    chan(S,D,request,T) & ~(st(S) ~= idle & req(S,S) = T) ->
        (chan(S,D,release,lastrel(S,D)) & lastrel(S,D) > T)

# A node in its critical section holds the least request in the whole system
# (not merely the least in its own queue).  This is the alternative form of
# `crit_least` noted in lamport_mutex_man.ivy; it is what identifies the
# critical node as one of the nodes "ahead of me".
invariant [crit_global_least]
    st(X) = critical & st(Y) ~= idle & Y ~= X -> lexord(req(X,X),X,req(Y,Y),Y)

# ---------------------------------------------------------------------------
# Fairness assumptions.
#
# All three are *weak* fairness (justice): the scheduler offers every rule a
# turn infinitely often.  Each flag is pulsed unconditionally, before the
# rule's guard, so a turn offered to a disabled rule is a stutter step and the
# assumption is an honest statement about the scheduler rather than a
# disguised assumption that the rule fires.
#
#   wfa_recv  : every channel is serviced infinitely often
#   wfa_check : every node tests its entry condition infinitely often
#   wfa_exit  : every node is offered the chance to leave its critical section
#
# No strong fairness (compassion) is needed anywhere: the arbiter of Lamport's
# algorithm is the (timestamp, id) order itself, which is FIFO, so -- unlike
# the German protocol -- weak fairness suffices.
# ---------------------------------------------------------------------------

explicit temporal axiom [wfa_recv]  forall S,D. globally eventually wf_recv(S,D)
explicit temporal axiom [wfa_check] forall N. globally eventually wf_check(N)
explicit temporal axiom [wfa_exit]  forall N. globally eventually wf_exit(N)

# ---------------------------------------------------------------------------
# Lemma [delivery] : every message in flight is eventually delivered.
#
# This is the CAV'24 timestamped-queue ranking.  The ranking is the set of
# timestamps still in the channel from _S to _D that are no larger than the
# tracked message's own timestamp _T:
#
#     delta(T1)  =  (exists K. chan(_S,_D,K,T1)) & T1 <= _T
#
# It is conserved because _S stamps every new message with a value strictly
# greater than its clock, which already dominates _T (invariant
# msg_below_clock); and every turn given to recv(_S,_D) removes the *least*
# timestamp in the channel, which is <= _T whenever the ranking is non-empty.
#
# Finiteness (Rule 5) comes from the ghost `last_ts`: it is a nullary symbol,
# so the monitor adds its value to the abstraction domain at the end of every
# step, which makes "every in-flight timestamp has been produced" inductive.
# ---------------------------------------------------------------------------

explicit temporal property [delivery]
  forall S,D,K,T. globally (chan(S,D,K,T) -> eventually ~chan(S,D,K,T))
proof {
  tactic skolemizenp;
  instantiate wfa_recv with S = _S, D = _D;
  tactic ranking with {
    definition work_created(T1:ts) = (exists K. chan(_S,_D,K,T1)) & T1 <= _T
    definition work_needed(T1:ts)  = (exists K. chan(_S,_D,K,T1)) & T1 <= _T
    definition work_invar          = chan(_S,_D,_K,_T)
    definition work_progress       = wf_recv(_S,_D)
    definition work_helpful        = exists K,T1. chan(_S,_D,K,T1) & T1 <= _T
  }
}

# ---------------------------------------------------------------------------
# The liveness property: every waiting node eventually enters its critical
# section.
#
#     forall C,R. globally (st(C) = waiting & req(C,C) = R
#                           -> eventually st(C) = critical)
#
# The request timestamp R is carried as a second Skolem constant so that every
# ranking can talk about "(_R,_C)", the position of the tracked request in the
# global (timestamp, id) order, without going through a state term.
#
# The proof is a single lexicographic ranking (Rule 10) with five components,
# highest order first.  Writing r = _R for the tracked request:
#
#  [00] _C's own outgoing messages with timestamp <= r.
#       Never grows: while _C waits it only ever sends replies, and those are
#       stamped above its clock, which already dominates r.  Emptying it means
#       every node has received _C's request.
#
#  [01] *every* message in flight with timestamp <= r.
#       May grow, but only from a node whose clock is still below r, and by
#       [aware] such a node has not yet received _C's request -- so [00] is
#       scheduled, which is what licenses the growth under Rule 10.
#       Emptying it means every request ordered at or before _C's has been
#       delivered everywhere.
#
#  [02] the nodes whose request is at or before (r,_C).
#       Reduced by exit_cs.  Its scheduler is just "somebody is in the
#       critical section": by [crit_global_least] a critical node holds the
#       least request in the system, hence is one of these nodes.  Grows only
#       when a node with a clock below r issues a request, i.e. under [00].
#
#  [03] the messages that can unblock one of those nodes: everything in flight
#       to such a node D up to `lastrr(S,D)`, the last reply-or-release S sent
#       it.  A reply is what satisfies D's "heard a later reply" test, a
#       release is what clears a stale entry from D's queue, so this is
#       exactly the prefix D still has to consume.  `lastrr` advances only
#       when S answers a request from D (whose timestamp is <= r, so [01] is
#       scheduled) or when S leaves its critical section (so [02] is).
#
#  [04] those nodes that are still waiting.
#       Reduced by check_cs once a node's entry test holds.  _C itself is one
#       of them, so the only way for this ranking to stop shrinking is for _C
#       to enter -- the goal.
#
# "Something is always scheduled" (premise S4, the `l2s_sched_exists` check)
# is the heart of the argument: if none of the five schedulers is on, take F
# to be the least node in [02].  F is waiting, F's request has been delivered
# everywhere ([01] empty), every reply owed to F has arrived ([03] empty,
# [replied_inflight]), and F's queue holds no stale earlier request
# ([stale_release]) -- so F can enter and [04] is scheduled after all.
# ---------------------------------------------------------------------------

explicit temporal property [live]
  forall C, R. globally ((st(C) = waiting & req(C,C) = R)
                         -> eventually st(C) = critical)
proof {
  tactic skolemizenp;
  instantiate wfa_recv;
  instantiate wfa_check;
  instantiate wfa_exit;
  tactic ranking with {

    definition work_created[00](S:node,D:node,T:ts) = (exists K. chan(S,D,K,T))
    definition work_needed[00](S:node,D:node,T:ts)  = (exists K. chan(S,D,K,T)) & S = _C & T <= _R
    definition work_invar[00]                       = st(_C) = waiting & req(_C,_C) = _R
    definition work_progress[00](S:node,D:node)     = wf_recv(S,D)
    definition work_helpful[00](S:node,D:node)      = S = _C & (exists K,T. chan(_C,D,K,T) & T <= _R)

    definition work_created[01](S:node,D:node,T:ts) = (exists K. chan(S,D,K,T))
    definition work_needed[01](S:node,D:node,T:ts)  = (exists K. chan(S,D,K,T)) & T <= _R
    definition work_invar[01]                       = st(_C) = waiting & req(_C,_C) = _R
    definition work_progress[01](S:node,D:node)     = wf_recv(S,D)
    definition work_helpful[01](S:node,D:node)      = exists K,T. chan(S,D,K,T) & T <= _R

    definition work_created[02](X:node)  = true
    definition work_needed[02](X:node)   = aheadeq(X,_R,_C)
    definition work_invar[02]            = st(_C) = waiting & req(_C,_C) = _R
    definition work_progress[02](X:node) = wf_exit(X)
    definition work_helpful[02](X:node)  = st(X) = critical

    definition work_created[03](S:node,D:node,T:ts) = (exists K. chan(S,D,K,T))
    definition work_needed[03](S:node,D:node,T:ts)  = (exists K. chan(S,D,K,T)) & aheadeq(D,_R,_C) & T <= lastrr(S,D)
    definition work_invar[03]                       = st(_C) = waiting & req(_C,_C) = _R
    definition work_progress[03](S:node,D:node)     = wf_recv(S,D)
    definition work_helpful[03](S:node,D:node)      = aheadeq(D,_R,_C) & (exists K,T. chan(S,D,K,T) & T <= lastrr(S,D))

    definition work_created[04](X:node)  = true
    definition work_needed[04](X:node)   = aheadeq(X,_R,_C) & st(X) = waiting
    definition work_invar[04]            = st(_C) = waiting & req(_C,_C) = _R
    definition work_progress[04](X:node) = wf_check(X)
    definition work_helpful[04](X:node)  = has_front & X = front & aheadeq(X,_R,_C) & st(X) = waiting & ~blocked(front)
  }
}

# ---------------------------------------------------------------------------
# Starvation freedom, stated without the auxiliary timestamp parameter:
#
#     every node waiting to enter its critical section eventually enters it.
#
# This is [live] with R instantiated at the tracked node's current request
# timestamp; it needs no ranking of its own, so the ranking is trivial and all
# the work is done by the progress condition (Rule 7, chaining liveness
# lemmas).
# ---------------------------------------------------------------------------

explicit temporal property [starvation_freedom]
  forall C. globally (st(C) = waiting -> eventually st(C) = critical)
proof {
  tactic skolemizenp;
  instantiate live with C = _C;
  tactic ranking with {
    definition work_created = true
    definition work_needed  = true
    definition work_invar   = eventually st(_C) = critical
    definition work_progress= st(_C) = critical
    definition work_helpful = true
  }
}
